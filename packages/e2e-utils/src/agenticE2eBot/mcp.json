{
    "mcpServers": {
        "playwright": {
            "type": "stdio",
            "command": "npx",
            "args": [
                "-y",
                "@playwright/mcp@0.0.74",
                "--cdp-endpoint=http://127.0.0.1:9222",
                "--output-dir=packages/e2e-utils/src/agenticE2eBot/reports/browser",
                "--timeout-action=15000"
            ]
        },
        "trezor-emulator": {
            "type": "sse",
            "url": "http://127.0.0.1:9003/sse"
        }
    }
}
